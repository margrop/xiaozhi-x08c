# Copy to /root/xiaozhi-minimax.env on the server and fill in real values.
# Never commit the populated file.
MINIMAX_API_KEY=<MINIMAX_API_KEY>
MINIMAX_GROUP_ID=<MINIMAX_GROUP_ID>
MINIMAX_LLM_MODEL=MiniMax-M2.5
MINIMAX_TTS_MODEL=speech-01-turbo
MINIMAX_TTS_VOICE=female-shaonv

# Optional QWeather (和风天气) configuration for the get_weather plugin.
# Apply at https://console.qweather.com/ ; free quota is normally 1000 calls/day.
QWEATHER_API_HOST=<QWEATHER_API_HOST>
QWEATHER_API_KEY=<QWEATHER_API_KEY>
QWEATHER_DEFAULT_LOCATION=上海

# Optional Home Assistant device control.
# Create a long-lived access token in HA: Profile -> Security -> Long-lived access tokens.
# Devices use: 位置,设备名称,entity_id; separate multiple devices with semicolons.
HOME_ASSISTANT_BASE_URL=http://<HOME_ASSISTANT_IP>:8123
HOME_ASSISTANT_API_KEY=<HOME_ASSISTANT_ACCESS_TOKEN>
HOME_ASSISTANT_DEVICES=客厅,主灯,switch.example;卧室,台灯,switch.example2
